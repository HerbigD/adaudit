# 复制为 .env 后生效（api/config.py 读取）

# ---------- 运行模式 ----------
# mock 下不调任何外部 API：VLM 返回确定性假结果、搜索返回假营养表，
# 全链路（含 interrupt / 回流 / 报告）可离线跑通 —— W1–W2 验收就用它。
APP_ENV=mock

# ---------- 模型 ----------
# mock | gemini | qwen | openai
VLM_PROVIDER=mock
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash
QWEN_MODEL=qwen-vl-max-latest
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ---------- 置信度阈值（eval 阶段扫参调优） ----------
DIRECT_THRESHOLD=0.85
VERIFIED_THRESHOLD=0.75
GENERAL_FALLBACK_THRESHOLD=0.80

# ---------- 搜索预算 ----------
SEARCH_MAX_QUERIES=3
SEARCH_TIMEOUT_S=10
SEARCH_RETRIES=1

# ---------- 检索 ----------
CACHE_HIT_THRESHOLD=0.82
MEMORY_TOPK=3

# ---------- 并发 ----------
MAX_CONCURRENT_GRAPHS=4
VLM_QPS=2
