# 复制为 .env 后生效（api/config.py 读取）

# ---------- 运行模式 ----------
# mock 下不调任何外部 API：VLM 返回确定性假结果、搜索返回假营养表，
# 全链路（含 interrupt / 回流 / 报告）可离线跑通。
# 切真实：APP_ENV=dev VLM_PROVIDER=qwen LLM_PROVIDER=qwen SEARCH_PROVIDER=dashscope
APP_ENV=mock

# ---------- 模型 ----------
# mock | gemini | qwen | openai
VLM_PROVIDER=mock
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-2.5-flash
# Day6 起统一单一模型全链路（多模态）：classify 传图、抽取/裁决传文本
QWEN_MODEL=qwen3.7-plus
OPENAI_MODEL=gpt-4o
# 想给感知/文本各用一个型号时才填，留空则都用 QWEN_MODEL
VLM_MODEL=
LLM_MODEL=
# 非思考模式：分类/抽取是结构化任务，thinking 只拖延迟与 token
QWEN_ENABLE_THINKING=false
# auto = 先试 response_format，被拒则降级到 prompt 契约 + 运行时校验
QWEN_JSON_MODE=auto

GEMINI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# 中国站 https://dashscope.aliyuncs.com/compatible-mode/v1
# 国际站 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 成本熔断（先行于任何真实调用） ----------
# 主熔断用 token：无货币歧义，是 provider 直接返回的事实。
# 累计落 data/usage.json（跨进程不丢），超预算立即拒调并落 trace。
DAILY_TOKEN_BUDGET=500000
# 成本只是估算，供人看，不参与拦截。
# 币种跟随百炼账单：中国站 = CNY、国际站 = USD —— 只改配置不改代码。
LLM_PRICE_IN_PER_MTOK=2
LLM_PRICE_OUT_PER_MTOK=8
COST_CURRENCY=CNY

# ---------- 搜索后端 ----------
# mock = 离线假数据；dashscope = 百炼内置联网（复用同一把 DASHSCOPE_API_KEY）
SEARCH_PROVIDER=mock

# ---------- 置信度阈值（eval 阶段扫参调优） ----------
DIRECT_THRESHOLD=0.85
VERIFIED_THRESHOLD=0.75
GENERAL_FALLBACK_THRESHOLD=0.80

# ---------- 搜索预算 ----------
SEARCH_MAX_QUERIES=3
SEARCH_TIMEOUT_S=10
SEARCH_RETRIES=1

# ---------- 检索 ----------
CACHE_HIT_THRESHOLD=0.82
MEMORY_TOPK=3

# ---------- 并发 ----------
MAX_CONCURRENT_GRAPHS=4
VLM_QPS=2
